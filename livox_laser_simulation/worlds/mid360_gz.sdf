<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="mid360_gz">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></visual>
      </link>
    </model>

    <!-- Same cylindrical calibration target used by test_pattern.world. -->
    <model name="pattern_test">
      <static>true</static>
      <link name="body">
        <visual name="visual"><geometry><mesh><uri>pattern_test.dae</uri></mesh></geometry></visual>
        <collision name="collision"><geometry><mesh><uri>pattern_test.dae</uri></mesh></geometry></collision>
      </link>
    </model>
    <include>
      <uri>model://Mid360</uri>
      <pose>0 0 0.08 0 0 0</pose>
    </include>
  </world>
</sdf>
