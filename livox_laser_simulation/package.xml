<?xml version="1.0"?>
<package format="3">
  <name>livox_laser_simulation</name>
  <version>0.1.0</version>
  <description>ROS 2 and Gazebo Sim (gz) Mid-360 LiDAR simulation.</description>
  <maintainer email="tfly@2085488186.com">tfly</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>gz-common5</depend>
  <depend>gz-msgs10</depend>
  <depend>gz-plugin2</depend>
  <depend>gz-sim8</depend>
  <depend>gz-transport13</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
